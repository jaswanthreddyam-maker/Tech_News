# ==============================================================================
# Tech News Today — Frontend Production Environment Contract (.env.example)
# Target Platform: Vercel CDN
# ==============================================================================

# [PUBLIC | RUNTIME | REQUIRED]
# Canonical API base URL for the backend FastAPI endpoints.
# Production: https://api.technewstoday.com/api/v1 (or https://your-railway-backend.up.railway.app/api/v1)
# Development: /api/v1 (proxied via Next.js rewrites)
NEXT_PUBLIC_API_URL=https://api.technewstoday.com/api/v1

# [PUBLIC | RUNTIME | REQUIRED]
# Supabase project public URL for client-side Auth and Storage queries.
# Production: https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# [PUBLIC | RUNTIME | REQUIRED]
# Supabase anonymous API key for browser client calls. Safe to expose.
# NEVER put SUPABASE_SERVICE_ROLE_KEY here!
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJKV1QiLCJhbGci...

# [PUBLIC | RUNTIME | OPTIONAL]
# Google OAuth Client ID for browser Google Sign-In.
# Production: 358464301429-xxxxxxxxxxxxxxxx.apps.googleusercontent.com
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# [PUBLIC | RUNTIME | OPTIONAL]
# Feature flag for displaying dynamic advertisement units.
NEXT_PUBLIC_ADS_ENABLED=false
