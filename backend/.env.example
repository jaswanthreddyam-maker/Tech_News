# ==============================================================================
# Tech News Today — Backend Production Environment Contract (.env.example)
# Target Platform: Railway (FastAPI API + Celery Worker + Celery Beat)
# Database: Supabase PostgreSQL (pgvector)
# Broker/Cache: Production Redis (Upstash / Railway Redis / Managed Redis)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION CONFIGURATION
# ------------------------------------------------------------------------------
# [SERVER_ONLY | RUNTIME | REQUIRED]
# Environment classification. Must be 'production' in production environment.
APP_ENV=production
ENV=production

# [SERVER_ONLY | RUNTIME | OPTIONAL]
# Application display name.
PROJECT_NAME="Tech News Today"

# [SERVER_ONLY | RUNTIME | REQUIRED]
# Port provided dynamically by Railway container runtime. Default: 8000
PORT=8000

# [SERVER_ONLY | RUNTIME | REQUIRED]
# Debug mode flag. MUST be set to false in production.
DEBUG=false

# [SECRET | RUNTIME | REQUIRED]
# Secret key for session encryption, HMAC token generation, and state protection.
# Must be at least 32 cryptographically secure random characters.
SECRET_KEY=change_this_to_a_secure_random_32_character_key_in_production

# [SECRET | RUNTIME | REQUIRED]
# JWT signing key for API authentication tokens.
# Must be at least 64 cryptographically secure random characters.
JWT_SECRET_KEY=change_this_to_a_secure_random_64_character_key_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ------------------------------------------------------------------------------
# 2. CORS & DOMAIN CONTRACTS
# ------------------------------------------------------------------------------
# [SERVER_ONLY | RUNTIME | REQUIRED]
# JSON array of allowed origins for Cross-Origin Resource Sharing (CORS).
# NEVER use wildcard "*" in production!
BACKEND_CORS_ORIGINS=["https://technewstoday.com", "https://frontend-production.vercel.app"]

# [SERVER_ONLY | RUNTIME | REQUIRED]
# Public canonical frontend web application URL (used for email links & redirects).
FRONTEND_URL=https://technewstoday.com

# [SERVER_ONLY | RUNTIME | REQUIRED]
# Public URL of the backend API (used for webhook receivers & OAuth callbacks).
BACKEND_PUBLIC_URL=https://api.technewstoday.com

# ------------------------------------------------------------------------------
# 3. DATABASE & SUPABASE CONFIGURATION
# ------------------------------------------------------------------------------
# [SECRET | RUNTIME | REQUIRED]
# Async PostgreSQL connection string targeting Supabase PostgreSQL (with pgvector extension enabled).
# Format: postgresql+asyncpg://postgres.[REF]:[PASSWORD]@[HOST]:5432/postgres
DATABASE_URL=postgresql+asyncpg://postgres:your_db_password@db.your-supabase-ref.supabase.co:5432/postgres

# [SERVER_ONLY | RUNTIME | OPTIONAL]
# Database connection pool bounds for Railway container processes.
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=15

# [SERVER_ONLY | RUNTIME | REQUIRED]
# Supabase project URL for administrative SDK and storage operations.
SUPABASE_URL=https://your-project-ref.supabase.co

# [SECRET | RUNTIME | REQUIRED]
# Supabase service role key for server-side administrative actions.
# NEVER expose to browser frontend!
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJKV1QiLCJ...

# ------------------------------------------------------------------------------
# 4. REDIS CONFIGURATION (Celery Broker, Locks & Caching)
# ------------------------------------------------------------------------------
# [SECRET | RUNTIME | REQUIRED]
# Production Redis connection string (Upstash / Railway Redis / Managed Redis).
# Use rediss:// (TLS) if required by the cloud Redis provider.
REDIS_URL=rediss://default:your_redis_password@your-redis-host.railway.app:6379/0

# ------------------------------------------------------------------------------
# 5. AI PROVIDER & ENRICHMENT
# ------------------------------------------------------------------------------
# [SERVER_ONLY | RUNTIME | REQUIRED]
# Active AI provider: 'openai', 'gemini', or 'disabled'
AI_PROVIDER=openai
AI_PROVIDER_PRIORITY=openai,gemini

# [SECRET | RUNTIME | CONDITIONAL]
# OpenAI API key (required if AI_PROVIDER is 'openai').
OPENAI_API_KEY=sk-proj-your-production-openai-api-key

# [SECRET | RUNTIME | CONDITIONAL]
# Gemini API key (required if AI_PROVIDER is 'gemini' or fallback).
GEMINI_API_KEY=

# [SERVER_ONLY | RUNTIME | OPTIONAL]
# Embedding model and dimensions for pgvector similarity indexing.
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# ------------------------------------------------------------------------------
# 6. DAILY BRIEFING & EMAIL DELIVERY (Resend Integration)
# ------------------------------------------------------------------------------
# [SECRET | RUNTIME | REQUIRED]
# Resend API key for daily briefing email delivery.
RESEND_API_KEY=re_your_live_resend_api_key

# [SECRET | RUNTIME | REQUIRED]
# Resend webhook signing secret for inbound delivery/bounce event signature verification.
RESEND_WEBHOOK_SECRET=whsec_your_resend_webhook_secret

# ------------------------------------------------------------------------------
# 7. BACKUP & ENCRYPTION KEYS
# ------------------------------------------------------------------------------
# [SECRET | RUNTIME | REQUIRED]
# 32-character AES key for encrypting database backups.
BACKUP_ENCRYPTION_KEY=change_this_to_32_char_encryption_key!

# [SECRET | RUNTIME | REQUIRED]
# 32-character key for signing database backup manifests.
BACKUP_SIGNING_KEY=change_this_to_32_char_signing_key!
